{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "/api/auth-handler?route=login"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth-handler?route=logout"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth-handler?route=me"
    },
    {
      "source": "/api/auth/register",
      "destination": "/api/auth-handler?route=register"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/public/index.html"
    }
  ]
}